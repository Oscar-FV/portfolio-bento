---
import Card from "../features/bento/components/Card.astro";
import Header from "../features/bento/components/sections/Header.astro";
import Layout from "../features/bento/layout/Layout.astro";

// src/pages/index.astro

---

<Layout>
  <nav class="h-20 bg-[#A89A91ff] shadow-sm rounded-lg animate-top">
	<Header />
  </nav>

  <div class="flex-grow h-full grid grid-cols-12 grid-rows-4 gap-3">
    <Card className="col-span-5 row-span-2 bg-[#D4CFCCff] animate-left"/>
    
    <Card className="col-span-5 row-span-3 col-start-8 row-start-1 bg-[#57402Bff] animate-right">
      3
    </Card>
    
    <Card className="col-span-2 row-span-2 col-start-6 row-start-1 bg-[#222725ff] relative overflow-hidden animate-first-element">
      <img src="/assets/me2.JPEG" alt="me" class="absolute object-cover h-full w-full" />
    </Card>
    
    <Card className="col-span-4 row-span-2 row-start-3 bg-[#57402Bff] animate-right">
      5
    </Card>
    
    <Card className="col-span-3 row-span-2 col-start-5 row-start-3 bg-[#A89A91ff] animate-bottom">
      6
    </Card>
    
    <Card className="col-span-5 col-start-8 row-start-4 bg-[#D4CFCCff] animate-left">
      7
    </Card>
  </div>
</Layout>
