---
import { ABOUT_ME } from "../../../../constants/AboutMe.constats";
import { MapPin, Coffee } from "@lucide/astro";
---

<div class="p-6 flex flex-col">
  <span class="flex gap-2 items-center">
    <MapPin size={18} />
    <p class="">San Luis Potosí, México</p>
  </span>
  <span class="mt-4">
    <p class="text-xl">
      Hey! I’m Oscar — fullstack developer from San Luis Potosí, Mexico. I build
      immersive web experiences using <strong>Python</strong>, <strong
        >React</strong
      >, and <strong>Next.js</strong> (Angular and I had a thing... but it’s complicated
      😅).
    </p>
    <p class="font-light text-lg mt-4">
      I got into tech thanks to video games and stuck around because I love
      turning ideas into sleek, user-focused apps. Front-end is my jam — I enjoy
      being the bridge between people and product.
    </p>
    <p class="flex gap-2 items-start mt-8">
      <Coffee size={36}/>
      <span class="font-light">
        Off the keyboard, I’m into competitive Valorant, long city walks, and
        hunting down the best espresso tonic in town. Always open to new
        projects and good convos — let’s connect!"
      </span>
    </p>
  </span>
</div>
